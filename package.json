{
  "name": "ffm-mcp",
  "version": "0.4.0",
  "description": "MCP server cho sea-fulfillment: stdio (login username/password) + remote HTTP/OAuth. Gọi /orders/get_orders, normalize order theo các field OrderExportExcel.js dùng để export Excel.",
  "type": "module",
  "bin": {
    "ffm-mcp": "dist/index.js",
    "ffm-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test test/",
    "start:http": "node dist/http.js",
    "dev": "tsc -w",
    "setup": "pm2 deploy ecosystem.config.cjs production setup",
    "deploy": "node deploy.cjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "pm2": "^5.4.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
